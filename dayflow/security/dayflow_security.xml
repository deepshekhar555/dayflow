<odoo>
    <record id="dayflow_payroll_rule_employee" model="ir.rule">
        <field name="name">Payroll: employee sees own</field>
        <field name="model_id" ref="model_dayflow_payroll"/>
        <field name="domain_force">[("employee_id.user_id","=",user.id)]</field>
        <field name="groups" eval="[(4, ref(''base.group_user''))]"/>
    </record>
    <record id="dayflow_payroll_rule_hr" model="ir.rule">
        <field name="name">Payroll: HR sees all</field>
        <field name="model_id" ref="model_dayflow_payroll"/>
        <field name="domain_force">[(1,"=",1)]</field>
        <field name="groups" eval="[(4, ref(''hr.group_hr_manager''))]"/>
    </record>
</odoo>
